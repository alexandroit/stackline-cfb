{
  "name": "@stackline/cfb",
  "version": "1.1.0",
  "author": "sheetjs",
  "description": "Drop-in replacement for cfb 1.2.2: read and write compound files (OLE/CFB), ZIP and MHT containers, with fixes for hangs, ZIP64, CVE-2024-22363 and bugs the original never released",
  "keywords": [
    "stackline",
    "npm-package",
    "cfb",
    "typescript",
    "nodejs",
    "compression",
    "office",
    "compound-file",
    "ole",
    "zip",
    "zip64",
    "mht",
    "parser",
    "writer",
    "sheetjs"
  ],
  "main": "./cfb",
  "types": "types",
  "browser": {
    "node": false,
    "process": false,
    "fs": false
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "cfb": "1.2.2",
    "crc-32": "npm:@stackline/crc-32@1.0.0",
    "mocha": "12.0.2",
    "typescript": "7.0.2",
    "uglify-js": "npm:@stackline/uglify-js@1.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-cfb.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && mocha --timeout 20000 test.js && node --test test/regression.test.cjs test/fixes.test.cjs && node test/legacy-smoke.js && npm run test:types",
    "test:regression": "node --test test/regression.test.cjs test/fixes.test.cjs",
    "test:types": "tsc -p types/tsconfig.test.json",
    "test:differential": "node scripts/differential.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "config": {
    "blanket": {
      "pattern": "cfb.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "types/index.d.ts",
    "types/tsconfig.json",
    "cfb.js",
    "xlscfb.flow.js",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "homepage": "https://alexandro.net/docs/vanilla/cfb/",
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-cfb/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
