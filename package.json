{
  "name": "@stackline/cfb",
  "version": "1.0.2",
  "author": "sheetjs",
  "description": "Read and write compound files and ZIP containers with the SheetJS CFB API and bounded FAT traversal",
  "keywords": [
    "stackline",
    "cfb",
    "compression",
    "office",
    "compound-file",
    "ole",
    "zip",
    "parser",
    "writer",
    "sheetjs"
  ],
  "main": "./cfb",
  "types": "types",
  "browser": {
    "node": false,
    "process": false,
    "fs": false
  },
  "dependencies": {},
  "devDependencies": {
    "crc-32": "npm:@stackline/crc-32@1.0.0",
    "mocha": "12.0.2",
    "uglify-js": "npm:@stackline/uglify-js@1.0.2",
    "typescript": "7.0.2",
    "@types/node": "20.19.43"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-cfb.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && mocha --timeout 20000 test.js && node --test test/regression.test.cjs",
    "test:regression": "node --test test/regression.test.cjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "config": {
    "blanket": {
      "pattern": "cfb.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "types/index.d.ts",
    "types/tsconfig.json",
    "cfb.js",
    "xlscfb.flow.js",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "homepage": "https://github.com/alexandroit/stackline-cfb#readme",
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-cfb/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
